# ===================================================================================
# 2D Bidisperse Granular System (frictionless)
#
# N=512, diameter ratio = 1:1.4
# Contact Model: Hooke contact + Damped dynamics relaxation (注意granular不支持FIRE)
# Oprating System: Windows
# ===================================================================================


# Step 0: 接受外部参数
variable        compress_rate index 0.1    # 首先,随便给一个浮点数,Lammps会自动把传进来的参数转化为浮点数
variable        compress_loop equal floor(1.0/v_compress_rate)
variable        pressfile string compress_rate/compress_rate_${compress_rate}/press_phi_compress_rate_${compress_rate}.txt
variable        pressfile string compress_rate/compress_rate_0.0001/press_phi_compress_rate_${compress_rate}.txt
variable        pressfile string compress_rate/compress_rate_0.0001/press_phi_compress_rate_0.0001.txt
variable        logfile   string compress_rate/compress_rate_${compress_rate}/log_compress_rate_${compress_rate}.txt
variable        logfile   string compress_rate/compress_rate_0.0001/log_compress_rate_${compress_rate}.txt
variable        logfile   string compress_rate/compress_rate_0.0001/log_compress_rate_0.0001.txt
variable        trajfile  string compress_rate/compress_rate_${compress_rate}/traj_compress_rate_${compress_rate}.xyz
variable        trajfile  string compress_rate/compress_rate_0.0001/traj_compress_rate_${compress_rate}.xyz
variable        trajfile  string compress_rate/compress_rate_0.0001/traj_compress_rate_0.0001.xyz



# Step 1: 单位规制
clear
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (src/comm.cpp:99)
  using 1 OpenMP thread(s) per MPI task
Loaded 0 plugins from D:\Programs\LAMMPS USER-REBOMOS Plugin 29Aug2024-MSMPI
Loaded 1 plugins from D:\Programs\LAMMPS\plugins
units           lj        # 这里说明的是长度、时间是无量纲、归一化单位
dimension       2
boundary        p p p
atom_style      sphere
# newton、comm_modify是"颗粒接触模型"的必要设置
newton          off
comm_modify     vel yes



# Step 2: 参数设置
# 外部脚本传入随机数种子
variable        seed equal 12345
variable        seed2 equal ${seed}+24681
variable        seed2 equal 12345+24681
# 实验体系 N=512
variable        N1 equal 256
variable        N2 equal 256
variable        N  equal ${N1}+${N2}
variable        N  equal 256+${N2}
variable        N  equal 256+256
variable        d1 equal 1.0
variable        d2 equal 1.4
variable        rho equal 1.0
# 计算盒子边长
variable        phi0 equal 0.50                    # 初始体积分数设低一些，避免严重重叠
variable        pi equal 3.141592653589793         # LAMMPS 里没有内置 π
variable        A1 equal ${N1}*${pi}*(${d1}*0.5)^2
variable        A1 equal 256*${pi}*(${d1}*0.5)^2
variable        A1 equal 256*3.14159265358979*(${d1}*0.5)^2
variable        A1 equal 256*3.14159265358979*(1*0.5)^2
variable        A2 equal ${N2}*${pi}*(${d2}*0.5)^2
variable        A2 equal 256*${pi}*(${d2}*0.5)^2
variable        A2 equal 256*3.14159265358979*(${d2}*0.5)^2
variable        A2 equal 256*3.14159265358979*(1.4*0.5)^2
variable        Area equal ${A1}+${A2}
variable        Area equal 201.061929829747+${A2}
variable        Area equal 201.061929829747+394.081382466303
variable        L0 equal sqrt(v_Area/v_phi0)       # 等价于sqrt(${Area}/${phi0})
variable        L0_fmt format L0 "%.2f"



# Step 3: 创建模拟盒,随机插入粒子
region          box block 0 ${L0} 0 ${L0} -0.1 0.1 units box
region          box block 0 34.5005307871067 0 ${L0} -0.1 0.1 units box
region          box block 0 34.5005307871067 0 34.5005307871067 -0.1 0.1 units box
print           "================== Create box and atoms... =================="
================== Create box and atoms... ==================
create_box      2 box
Created orthogonal box = (0 0 -0.1) to (34.500531 34.500531 0.1)
  4 by 2 by 1 MPI processor grid
create_atoms    1 random ${N1} ${seed}  box
create_atoms    1 random 256 ${seed}  box
create_atoms    1 random 256 12345  box
Created 256 atoms
  using lattice units in orthogonal box = (0 0 -0.1) to (34.500531 34.500531 0.1)
  create_atoms CPU = 0.001 seconds
create_atoms    2 random ${N2} ${seed2} box
create_atoms    2 random 256 ${seed2} box
create_atoms    2 random 256 37026 box
Created 256 atoms
  using lattice units in orthogonal box = (0 0 -0.1) to (34.500531 34.500531 0.1)
  create_atoms CPU = 0.000 seconds
# 设置粒子属性
set             type 1 diameter ${d1}
set             type 1 diameter 1
Setting atom values ...
  256 settings made for diameter
set             type 1 density  ${rho}      # 设置粒子密度,Lammps会自动计算质量和转动惯量
set             type 1 density  1      
Setting atom values ...
  256 settings made for density
set             type 2 diameter ${d2}
set             type 2 diameter 1.4
Setting atom values ...
  256 settings made for diameter
set             type 2 density  ${rho}
set             type 2 density  1
Setting atom values ...
  256 settings made for density
print           "============================================================"
============================================================
# 强制二维运动
fix             planar all enforce2d        # 关键:强制所有粒子只能在z=0平面内运动



# Step 4: 定义相互作用/接触模型
pair_style      gran/hooke/history 2.0e4 0.0 100.0 0.0 0.0 1
pair_coeff      * *
neighbor        0.5 bin
neigh_modify    delay 0 every 1 check yes
# 设置松弛方式:  "阻尼动力学松弛"(FIRE能量最小化的替代方案)
fix             integrator all nve/sphere  # 因为系统粒子的atom_style sphere,不能用普通nve
fix             damp all viscous 20.0



# Step 5: 定义观测量
compute         ke_trans all ke
compute         ke_rot   all erotate/sphere
variable        KE    equal "c_ke_trans"             # 系统-平动动能
variable        KEr   equal "c_ke_rot"               # 系统-转动动能
variable        phi   equal "v_Area/(lx*ly)"         # 当前体积分数,从L0 -> 1
variable        KEtot equal "c_ke_trans + c_ke_rot"  # 系统总动能
variable        pr    equal "press"                  # 系统压力
# 记录和盒子相关变量
variable        st    equal "step"                   # 当前步数
variable        lxv   equal "lx"                     # 当前盒子长度x
variable        lyv   equal "ly"                     # 当前盒子长度y


# Step 6: 控制输出内容
# (1)基本参数输出
print           "================== Simulation Parameters ==================" append ${logfile}
print           "================== Simulation Parameters ==================" append compress_rate/compress_rate_0.0001/log_compress_rate_0.0001.txt
================== Simulation Parameters ==================
print           "L0 = ${L0_fmt}"  append ${logfile}
print           "L0 = ${L0_fmt}"  append compress_rate/compress_rate_0.0001/log_compress_rate_0.0001.txt
L0 = 34.50
print           "N = ${N}, N1 = ${N1}, N2 = ${N2}" append ${logfile}
print           "N = ${N}, N1 = ${N1}, N2 = ${N2}" append compress_rate/compress_rate_0.0001/log_compress_rate_0.0001.txt
N = 512, N1 = 256, N2 = 256
print           "phi = ${phi0}"  append ${logfile}
print           "phi = ${phi0}"  append compress_rate/compress_rate_0.0001/log_compress_rate_0.0001.txt
phi = 0.5
print           "seed = ${seed}"  append ${logfile}
print           "seed = ${seed}"  append compress_rate/compress_rate_0.0001/log_compress_rate_0.0001.txt
seed = 12345
print           "compress_rate = ${compress_rate}" append ${logfile}
print           "compress_rate = ${compress_rate}" append compress_rate/compress_rate_0.0001/log_compress_rate_0.0001.txt
compress_rate = 0.0001
print           "===========================================================" append ${logfile}
print           "===========================================================" append compress_rate/compress_rate_0.0001/log_compress_rate_0.0001.txt
===========================================================
# (2)热力学输出(每5000步输出一轮):
thermo          5000
thermo_style    custom step atoms lx ly v_phi press ke c_ke_rot
# (3)轨迹输出(每5000步输出一次,用Ovito可视化)
dump            traj all custom 5000 ${trajfile} id type x y z radius vx vy vz fx fy fz
dump            traj all custom 5000 compress_rate/compress_rate_0.0001/traj_compress_rate_0.0001.xyz id type x y z radius vx vy vz fx fy fz
dump_modify     traj sort id                         # 让每帧按粒子id排序,对后处理很方便




# Step 7: 运行模拟
# Step 7.1: 松弛
print           "================== Stage 1: initial relaxation =================="  append ${logfile}
print           "================== Stage 1: initial relaxation =================="  append compress_rate/compress_rate_0.0001/log_compress_rate_0.0001.txt
================== Stage 1: initial relaxation ==================
timestep        5.0e-5
run             50000
