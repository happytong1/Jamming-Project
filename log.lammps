print           "================= Stage 2: Compression Loop... =================="  append ${logfile}
print           "================= Stage 2: Compression Loop... =================="  append compress_rate/compress_rate_0.0001/log_compress_rate_0.0001.txt
================= Stage 2: Compression Loop... ==================
print           "cycle step phi press KEtotal"  append ${logfile}
print           "cycle step phi press KEtotal"  append compress_rate/compress_rate_0.0001/log_compress_rate_0.0001.txt
cycle step phi press KEtotal
print           "cycle step phi press KEtotal"  append ${pressfile}
print           "cycle step phi press KEtotal"  append compress_rate/compress_rate_0.0001/press_phi_compress_rate_0.0001.txt
cycle step phi press KEtotal
# 压缩参数
variable        ncycle equal 150
variable        scale  equal 0.998

# --------------------------------------------------------------------------------
# 编写循环压缩代码: loop_compress
label           loop_compress
variable        i loop ${ncycle}
variable        i loop 150
# @before(压缩之前的我不关注)
change_box      all x scale ${scale} y scale ${scale} remap units box
change_box      all x scale 0.998 y scale ${scale} remap units box
change_box      all x scale 0.998 y scale 0.998 remap units box
